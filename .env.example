# --- AI copy generation (optional) ---
# If set, the /api/recommend route uses Claude to generate personalized, on-brand
# recommendation copy. If UNSET, the API falls back to a deterministic template
# engine (fully functional, no external calls). The key NEVER reaches the client.
ANTHROPIC_API_KEY=

# Model used for recommendation copy (safe default if unset). Any current Claude
# model works — the request sends no model-specific params. Default: claude-haiku-4-5.
ANTHROPIC_MODEL=claude-haiku-4-5

# --- Shopify (for the Liquid theme app extension / storefront wiring) ---
# Used only by the Shopify app extension + docs, not the Next.js prototype demo.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_API_TOKEN=
